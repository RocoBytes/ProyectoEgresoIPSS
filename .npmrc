# Defensas de cadena de suministro (aprobadas el 26-11-2026).
# Las versiones maliciosas de 2025 y 2026 estuvieron publicadas entre minutos y horas:
# no se instala nada publicado hace menos de 7 días.
min-release-age=7
# Toda dependencia nueva queda con versión exacta, no con rango.
save-exact=true
# Solo corren los scripts de instalación aprobados en "allowScripts" del package.json raíz;
# cualquier otro hace fallar la instalación en vez de ejecutarse con un aviso.
strict-allow-scripts=true
