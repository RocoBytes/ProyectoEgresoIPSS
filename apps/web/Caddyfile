{
	# Sin API de administración ni certificados: este Caddy solo sirve archivos dentro de la red
	# interna; el TLS lo termina el proxy de infra/Caddyfile.
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Los archivos de /assets llevan el hash de su contenido en el nombre, así que nunca cambian.
	@activos path /assets/*
	header @activos Cache-Control "public, max-age=31536000, immutable"

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# Respaldo de la SPA: cualquier ruta que no sea un archivo devuelve index.html y la resuelve React Router.
	try_files {path} /index.html
	file_server
}
