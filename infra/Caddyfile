# Validado con `caddy validate` en caddy 2.11.9 el 2026-11-26.
{
	servers {
		# Sin esto Caddy descarta el X-Forwarded-For entrante y la API ve la IP de Cloudflare, no la del usuario.
		# Rangos de https://www.cloudflare.com/ips-v4 (revisar al desplegar).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$DOMINIO} {
	encode zstd gzip

	# El volumen de evidencias no se monta en este contenedor: los archivos solo salen por la API.
	handle /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:80
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
