# Validado con `caddy validate` en caddy 2.11.9 el 2026-11-27.
{
	servers {
		# Sin esto Caddy descarta el X-Forwarded-For entrante y la API ve la IP de Cloudflare, no la del usuario.
		# Rangos de https://www.cloudflare.com/ips-v4 (revisar al desplegar).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$DOMINIO} {
	encode zstd gzip

	# El volumen de evidencias no se monta en este contenedor: los archivos solo salen por la API.
	handle /api/* {
		# Igual al tope de 100 MB del plan gratuito de Cloudflare y al límite propio de la API.
		request_body {
			max_size 100MB
		}
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:80
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Errores que genera Caddy mismo (413 por el tope de arriba, 502 o 503 si la API o la web no responden, etc.).
	# `header -Server` del bloque anterior no los alcanza: las rutas de error van aparte, así que se repite aquí.
	# Lo que responden la API y la web no pasa por este bloque y llega tal cual.
	handle_errors {
		header -Server

		# Mismo cuerpo que devuelve la API (subida-evidencias.interceptor.ts): la web ya sabe mostrar su `message`.
		@envio_grande expression {err.status_code} == 413
		handle @envio_grande {
			header Content-Type application/json
			respond `{"statusCode":413,"message":"El envío supera los 100 MB en total. Adjunta menos fotos o reduce su tamaño."}` 413
		}

		@servicio_caido expression {err.status_code} >= 500
		handle @servicio_caido {
			header Content-Type application/json
			respond `{"statusCode":{err.status_code},"message":"El servicio no está disponible por ahora. Inténtalo de nuevo en unos minutos."}` {err.status_code}
		}

		handle {
			header Content-Type application/json
			respond `{"statusCode":{err.status_code},"message":"No se pudo procesar la solicitud."}` {err.status_code}
		}
	}
}
