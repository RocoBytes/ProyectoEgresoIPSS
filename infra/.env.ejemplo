# Copiar a infra/.env y completar. Ese archivo no se sube al repositorio.

# --- Obligatorias: sin ellas `docker compose` se detiene con un mensaje ---

# Nombre público del sitio; Caddy obtiene el certificado para este dominio.
DOMINIO=plataforma.instituto.example
# Organización dueña de las imágenes en GHCR, en minúsculas.
GHCR_ORG=cambiar-por-la-organizacion
# Etiqueta de las imágenes a ejecutar (la del tag publicado).
VERSION=v1.0.0
# Clave del superusuario postgres. Generar con: openssl rand -hex 24
CLAVE_BD_SUPERUSUARIO=cambiar-por-un-valor-aleatorio
# Clave del rol ipss_migrador (dueño del esquema). Generar con: openssl rand -hex 24
CLAVE_BD_MIGRADOR=cambiar-por-un-valor-aleatorio
# Clave del rol ipss_api (sin DELETE ni TRUNCATE). Generar con: openssl rand -hex 24
CLAVE_BD_API=cambiar-por-un-valor-aleatorio
# Secreto de firma de las sesiones (JWT). Generar con: openssl rand -hex 32
JWT_SECRETO=cambiar-por-un-valor-aleatorio

# --- Opcionales (se muestran con su valor por defecto) ---

# Puerto publicado para HTTP.
#PUERTO_HTTP=80
# Puerto publicado para HTTPS.
#PUERTO_HTTPS=443
# Hora del respaldo diario, hora de Santiago.
#HORA_RESPALDO=03:00
# Días que se conservan los respaldos.
#DIAS_RETENCION=14
# Segundos de espera entre reintentos de un respaldo fallido.
#REINTENTO_SEGUNDOS=1800
# Intentos de respaldo por día.
#MAX_INTENTOS=3
